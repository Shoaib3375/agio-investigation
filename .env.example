# ── AGIO Investigation Service — configuration ───────────────────────────────
# Values verified against the live Laravel PaymentExchange M15/M16/M17
# implementation (see docs/AGIO_INVESTIGATION_READINESS_AUDIT.md).
# Copy to .env and adjust for your environment. Never commit .env.

APP_ENV=local
LOG_LEVEL=DEBUG

# ── Investigation database (separate from Laravel's DB) ──────────────────────
# A dedicated PostgreSQL database. Never connect to Laravel's paymentexchange DB.
INVESTIGATION_DATABASE_URL=postgresql+psycopg://investigation:local_password@investigation-database:5432/agio_investigation

# ── RabbitMQ ─────────────────────────────────────────────────────────────────
# Same broker as Laravel. The vhost MUST be `agio` (Laravel's RABBITMQ_VHOST).
RABBITMQ_URL=amqp://agio:agio_secret@rabbitmq:5672/agio

# Exchange Laravel publishes to (topic). Verified: agio.events
RABBITMQ_EXCHANGE=agio.events

# Consumer queue. Two options (PY-M02 will pick one):
#   1) Consume the queue Laravel already declares: agio.investigation (bound with #)
#   2) Declare your own durable queue bound to agio.events with routing key #
# Default below is the Laravel-declared queue. Override to declare your own.
RABBITMQ_QUEUE=agio.investigation
RABBITMQ_QUEUE_DURABLE=true
RABBITMQ_ROUTING_KEY=#

# Dead-letter + retry topology (Laravel-declared; for reference / consumer-side retry)
RABBITMQ_DLX=agio.dlx
RABBITMQ_DLQ=agio.dead_letters
RABBITMQ_RETRY_EXCHANGE=agio.retry
RABBITMQ_RETRY_QUEUE=agio.retry.60s
RABBITMQ_RETRY_TTL_MS=60000

# Consumer tuning
RABBITMQ_PREFETCH=16
RABBITMQ_MAX_RETRIES=3

# ── Laravel internal investigation API ──────────────────────────────────────
# Internal read-only API. Base path verified: /api/internal/investigation/v1
LARAVEL_INTERNAL_API_URL=http://app:8000/api/internal/investigation/v1

# Sanctum token with the `service:internal` ability (NOT service:investigation:read).
# Issue on the Laravel side with: php artisan investigation:issue-token --name=agio-investigation-service
# Sent as: Authorization: Bearer <token>
LARAVEL_SERVICE_TOKEN=
LARAVEL_API_TIMEOUT_SECONDS=10
LARAVEL_API_MAX_RETRIES=2

# ── LLM (disabled until PY-M07) ──────────────────────────────────────────────
LLM_PROVIDER=disabled
LLM_API_KEY=
LLM_MODEL=

# ── RAG (disabled until PY-M08) ──────────────────────────────────────────────
EMBEDDING_PROVIDER=disabled
EMBEDDING_API_KEY=
